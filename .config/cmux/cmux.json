{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,
  "app": {
    "sendAnonymousTelemetry": true
  },
  "actions": {
    "main": {
      "title": "Main",
      "type": "workspace",
      "workspace": {
        "cwd": "~/Downloads",
        "layout": {
          "pane": {
            "surfaces": [
              {
                "name": "Base",
                "type": "terminal"
              },
              {
                "name": "Update",
                "type": "terminal"
              },
            ]
          },
        },
      },
    },
    "split-two": {
      "title": "Split-Two",
      "type": "workspace",
      "workspace": {
        "cwd": "~/Downloads",
        "layout": {
          "children": [
            {
              "pane": {
                "surfaces": [
                  {
                    "focus": true,
                    "type": "terminal"
                  }
                ]
              }
            },
            {
              "pane": {
                "surfaces": [
                  {
                    "type": "terminal"
                  }
                ]
              }
            }
          ],
          "direction": "horizontal",
          "split": 0.5
        },
        "name": "Split-Two"
      },
    },
    "split-three": {
      "title": "Split-Three",
      "type": "workspace",
      "workspace": {
        "color": "#922B21",
        "cwd": "~/Downloads",
        "layout": {
          "children": [
            {
              "pane": {
                "surfaces": [
                  {
                    "focus": true,
                    "type": "terminal"
                  }
                ]
              }
            },
            {
              "children": [
                {
                  "pane": {
                    "surfaces": [
                      {
                        "type": "terminal"
                      }
                    ]
                  }
                },
                {
                  "pane": {
                    "surfaces": [
                      {
                        "type": "terminal"
                      }
                    ]
                  }
                }
              ],
              "direction": "vertical",
              "split": 0.5
            },
          ],
          "direction": "horizontal",
          "split": 0.5
        },
        "name": "Split-Three"
      },
    },
  },
}
